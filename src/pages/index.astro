---
import Layout from '../layouts/Layout.astro';
import TitleBar from '../components/TitleBar.astro';
import StickyPhoneBar from '../components/StickyPhoneBar.astro';
import ServicesHero from '../components/ServicesHero.astro';
import BottomNav from '../components/BottomNav.astro';
---

<Layout title="Ozz Max - Automotive Services">
  <main class="min-h-screen bg-[#323232] text-white flex flex-col justify-between">
    <div>
      <!-- 1. Header (Scrolls away) -->
      <TitleBar />

      <!-- 2. Sticky Phone Bar (Locks to top on scroll) -->
      <StickyPhoneBar />

      <!-- 3. Photo & 2-Column Services -->
      <ServicesHero />
    </div>

    <!-- 4. Footer / Bottom Navigation -->
    <BottomNav />
  </main>
</Layout>