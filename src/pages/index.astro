---
import Layout from '../layouts/Layout.astro';
import TitleBar from '../components/TitleBar.astro';
import StickyPhoneBar from '../components/StickyPhoneBar.astro';
import ServicesHero from '../components/ServicesHero.astro';
import CallToAction from '../components/CallToAction.astro';
import HoursOfOperation from '../components/HoursOfOperation.astro';
import BottomNav from '../components/BottomNav.astro';
---

<Layout title="Ozz Max - Automotive Services">
  <main class="min-h-screen bg-[#323232] text-white flex flex-col justify-between">
    <div>
      <TitleBar />
      <StickyPhoneBar />
      <ServicesHero />
      <CallToAction />
      <HoursOfOperation />
    </div>

    <BottomNav />
  </main>
</Layout>