---
import { Facebook, MapPin } from 'lucide-astro';
---
<footer class="w-full bg-black py-4 shadow-[0_-4px_17px_rgba(68,18,18,1)]">
  <div class="flex justify-center gap-6">
    <a href="https://facebook.com" class="flex flex-col items-center gap-1 text-[#A12626] font-['Inter'] font-semibold text-sm">
      <Facebook stroke-width={1.5} class="w-6 h-6 border-2 border-[#A12626] p-0.5 rounded" />
      <span>Facebook</span>
    </a>
    <a href="#location" class="flex flex-col items-center gap-1 text-[#A12626] font-['Inter'] font-semibold text-sm">
      <MapPin stroke-width={1.5} class="w-6 h-6 border-2 border-[#A12626] p-0.5 rounded" />
      <span>Find Us</span>
    </a>
  </div>
</footer>