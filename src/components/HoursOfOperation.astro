---
const hours = [
  { day: 'Monday', time: '10:00 - 17:30' },
  { day: 'Tuesday', time: '10:00 - 17:30' },
  { day: 'Wednesday', time: '10:00 - 17:30' },
  { day: 'Thursday', time: '10:00 - 17:30' },
  { day: 'Friday', time: '10:00 - 17:30' },
  { day: 'Saturday', time: '10:00 - 17:30' },
  { day: 'Sunday', time: 'CLOSED', closed: true },
];

// Helper to format initial SSR state to 12-hour
function convertTimeTo12H(timeStr: string): string {
  const [hours, minutes] = timeStr.split(':').map(Number);
  const period = hours >= 12 ? 'PM' : 'AM';
  const convertedHour = hours % 12 || 12;
  return `${convertedHour}:${minutes.toString().padStart(2, '0')} ${period}`;
}

function formatRange(rangeStr: string): string {
  return rangeStr
    .split('-')
    .map((t) => convertTimeTo12H(t.trim()))
    .join(' - ');
}
---

<!-- Section background with red to dark red gradient -->
<section class="flex justify-center px-4 py-8 w-full bg-gradient-to-b from-[#A12626]/30 via-red-950/20 to-black/40">
  
  <!-- Solid Black Inner Card -->
  <div class="flex flex-col items-center gap-[13px] bg-black border-[3px] border-[#3F3F3F] rounded-[13px] px-[7px] py-[19px] max-w-[366px] w-full h-auto shadow-2xl">
    
    <!-- Header Title & Controls (Status Dot + Format Button) -->
    <div class="flex justify-between items-center border-b border-[#3F3F3F] pb-3 w-full px-4">
      <h2 class="font-['Oswald'] text-[24px] font-normal leading-[112%] tracking-[0.03em] text-white uppercase">
        Hours ⏱️
      </h2>

      <div class="flex items-center gap-3">
        <!-- Status Indicator Dot + Text -->
        <div class="flex flex-col items-center justify-center">
          <span 
            id="hours-status-dot" 
            class="w-3.5 h-3.5 rounded-full bg-gray-400 transition-colors duration-300"
          ></span>
          <span 
            id="hours-status-text" 
            class="font-['Oswald'] text-[18px] uppercase tracking-wider text-white mt-0.5 leading-none"
          >
            ...
          </span>
        </div>

        <!-- 12H / 24H Toggle Button -->
        <button
          id="format-toggle-btn"
          aria-label="Toggle time format"
          class="font-['Oswald'] text-base uppercase px-3 py-1.5 rounded border border-[#3F3F3F] text-[#B7B7B7] hover:text-white hover:border-white transition-colors cursor-pointer"
        >
          <span id="format-label">24H</span>
        </button>
      </div>
    </div>

    <!-- Hours List -->
    <div class="flex flex-col gap-3 w-full px-4 pt-2 font-['Oswald'] text-[24px] font-normal leading-[112%] tracking-[0.03em] text-white">
      {hours.map((item) => (
        <div class="flex justify-between items-center">
          <span class="text-left">{item.day}</span>
          <span 
            class={`time-display text-right ${item.closed ? 'text-[#71717A]' : 'text-[#B7B7B7]'}`}
            data-original-time={item.time}
            data-closed={item.closed ? "true" : "false"}
          >
            {item.closed ? item.time : formatRange(item.time)}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const toggleBtn = document.getElementById('format-toggle-btn');
  const formatLabel = document.getElementById('format-label');
  const timeElements = document.querySelectorAll('.time-display');
  const statusDot = document.getElementById('hours-status-dot');
  const statusText = document.getElementById('hours-status-text');

  // Set default state to 12-hour mode
  let is24Hour = false;

  // Check Queensland open/closed status
  function checkOpenStatus() {
    if (!statusDot || !statusText) return;

    const now = new Date();
    const formatter = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Australia/Brisbane',
      weekday: 'short',
      hour: 'numeric',
      minute: 'numeric',
      hour12: false
    });

    const parts = formatter.formatToParts(now);
    let day = '';
    let hour = 0;
    let minute = 0;

    parts.forEach(p => {
      if (p.type === 'weekday') day = p.value;
      if (p.type === 'hour') hour = parseInt(p.value, 10);
      if (p.type === 'minute') minute = parseInt(p.value, 10);
    });

    const currentMinuteOfDay = hour * 60 + minute;
    const openTime = 10 * 60;        // 10:00 AM
    const closeTime = 17 * 60 + 30;  // 5:30 PM

    const isWorkingDay = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].includes(day);
    const isOpen = isWorkingDay && currentMinuteOfDay >= openTime && currentMinuteOfDay < closeTime;

    if (isOpen) {
      statusDot.className = 'w-3.5 h-3.5 rounded-full bg-[#84cc16] shadow-[0_0_8px_rgba(132,204,22,0.8)]';
      statusText.textContent = 'Open';
    } else {
      statusDot.className = 'w-3.5 h-3.5 rounded-full bg-[#dc2626] shadow-[0_0_8px_rgba(220,38,38,0.8)]';
      statusText.textContent = 'Closed';
    }
  }

  checkOpenStatus();
  setInterval(checkOpenStatus, 60000);

  function convertTimeTo12H(timeStr: string): string {
    const [hours, minutes] = timeStr.split(':').map(Number);
    const period = hours >= 12 ? 'PM' : 'AM';
    const convertedHour = hours % 12 || 12;
    return `${convertedHour}:${minutes.toString().padStart(2, '0')} ${period}`;
  }

  function formatRange(rangeStr: string): string {
    return rangeStr
      .split('-')
      .map((t) => convertTimeTo12H(t.trim()))
      .join(' - ');
  }

  toggleBtn?.addEventListener('click', () => {
    is24Hour = !is24Hour;

    if (formatLabel) {
      formatLabel.textContent = is24Hour ? '12H' : '24H';
    }

    timeElements.forEach((el) => {
      const htmlEl = el as HTMLElement;
      const isClosed = htmlEl.dataset.closed === 'true';
      const originalTime = htmlEl.dataset.originalTime || '';

      if (isClosed) return;

      if (is24Hour) {
        htmlEl.textContent = originalTime;
      } else {
        htmlEl.textContent = formatRange(originalTime);
      }
    });
  });
</script>