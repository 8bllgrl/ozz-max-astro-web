---
const hours = [
  { day: 'Monday', time: '10:00 - 17:30' },
  { day: 'Tuesday', time: '10:00 - 17:30' },
  { day: 'Wednesday', time: '10:00 - 17:30' },
  { day: 'Thursday', time: '10:00 - 17:30' },
  { day: 'Friday', time: '10:00 - 17:30' },
  { day: 'Saturday', time: '10:00 - 17:30' },
  { day: 'Sunday', time: 'CLOSED', closed: true },
];
---

<section class="flex justify-center px-4 py-4 w-full">
  <div class="flex flex-col items-center gap-[13px] bg-black border-[3px] border-[#3F3F3F] rounded-[13px] px-[7px] py-[19px] max-w-[366px] w-full h-auto">
    
    <!-- Header Title -->
    <h2 class="font-['Oswald'] text-[24px] font-normal leading-[112%] tracking-[0.03em] text-center text-white uppercase border-b border-[#3F3F3F] pb-3 w-full">
      Hours ⏱️
    </h2>

    <!-- Hours List -->
    <div class="flex flex-col gap-3 w-full px-4 pt-2 font-['Oswald'] text-[24px] font-normal leading-[112%] tracking-[0.03em] text-white">
      {hours.map((item) => (
        <div class="flex justify-between items-center">
          <span class="text-left">{item.day}</span>
          <span class={`text-right ${item.closed ? 'text-[#71717A]' : 'text-[#B7B7B7]'}`}>
            {item.time}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>