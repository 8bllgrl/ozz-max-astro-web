<form class="max-w-md mx-auto bg-white p-6 rounded-lg border border-gray-200 flex flex-col gap-4">
  <div class="flex flex-col gap-2">
    <label for="name" class="font-['Inter'] text-sm text-gray-800">Name</label>
    <input type="text" id="name" required class="p-3 border border-gray-300 rounded-lg text-black focus:outline-none focus:border-zinc-800" />
  </div>

  <div class="flex flex-col gap-2">
    <label for="email" class="font-['Inter'] text-sm text-gray-800">Email</label>
    <input type="email" id="email" required class="p-3 border border-gray-300 rounded-lg text-black focus:outline-none focus:border-zinc-800" />
  </div>

  <div class="flex flex-col gap-2">
    <label for="message" class="font-['Inter'] text-sm text-gray-800">Message</label>
    <textarea id="message" rows="4" required class="p-3 border border-gray-300 rounded-lg text-black focus:outline-none focus:border-zinc-800 resize-y"></textarea>
  </div>

  <button type="submit" class="w-full py-3 bg-[#2C2C2C] text-white font-['Inter'] rounded-lg font-medium hover:bg-black transition-colors">
    Submit
  </button>
</form>